# Optional live source discovery (leave empty for offline mode).
TAVILY_API_KEY=

# Local demo only. Do not expose the standard-library server publicly.
CAREERSHIELD_HOST=127.0.0.1
CAREERSHIELD_PORT=8000

# Investigation bounds; the application clamps values to safe ranges.
CAREERSHIELD_MAX_TOOL_CALLS=8
CAREERSHIELD_TOOL_TIMEOUT_SECONDS=4
CAREERSHIELD_MAX_DURATION_SECONDS=15
